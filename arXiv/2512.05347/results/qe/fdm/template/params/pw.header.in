&CONTROL
  calculation = 'scf'
  etot_conv_thr =   9.0000000000d-05
  forc_conv_thr =   1.0000000000d-04
  outdir = './out/'
  prefix = 'SiO2'
  pseudo_dir = './pseudo/'
  disk_io = 'nowf'
  tprnfor = .true.
  tstress = .true.
  verbosity = 'high'

  nstep = 1000
/
&SYSTEM
  degauss =   2.0000000000d-02
  ecutrho =   4.0000000000d+02
  ecutwfc =   5.0000000000d+01
  ibrav = 0
  nat = 72
  nosym = .false.
  ntyp = 2
  occupations = 'smearing'
  smearing = 'cold'
/
&ELECTRONS
  conv_thr =   1.8000000000d-09
  electron_maxstep = 80
  mixing_beta =   4.0000000000d-01
/
K_POINTS automatic
2 2 2 0 0 0
